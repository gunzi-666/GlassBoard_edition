<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>GlassBoard</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <DefaultItemExcludes>$(DefaultItemExcludes);GlassBoard.Updater\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Interop.UIAutomationClient">
      <HintPath>..\Interop.UIAutomationClient.dll</HintPath>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationCore" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Management" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>
  <!-- 更新白名单不允许新增文件，NuGet 依赖全部嵌入 GlassBoard.exe，运行时由 EmbeddedAssemblies 释放加载 -->
  <Target Name="EmbedPackageAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <PackageCopyLocal Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''" />
      <EmbeddedResource Include="@(PackageCopyLocal)" Condition="'%(PackageCopyLocal.Extension)' == '.dll'">
        <LogicalName>runtime/%(PackageCopyLocal.Filename)%(PackageCopyLocal.Extension)</LogicalName>
      </EmbeddedResource>
      <ReferenceCopyLocalPaths Remove="@(PackageCopyLocal)" />
    </ItemGroup>
  </Target>
</Project>